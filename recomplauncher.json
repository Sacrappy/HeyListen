{
  "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
  "format": 1,
  "name": "HeyListen",
  "repo": "Sacrappy/HeyListen",
  "game": {
    "kind": "iso_or_folder",
    "label": "Your copy of The Legend of Zelda: Ocarina of Time for Nintendo Switch 2, version 131072 (build e0f3ccfa): the .nup file, or the folder that holds its romfs and exefs.",
    "check": {
      "nup_build_id": "e0f3ccfa"
    }
  },
  "inputs": [
    {
      "id": "dlss",
      "label": "NVIDIA DLSS runtime",
      "role": "runtime",
      "shared": "nvidia.dlss",
      "optional": true,
      "destination": "HeyListen/ngx/nvngx_dlss.dll"
    }
  ],
  "start": {
    "program": [
      "HeyListenBuilder-Setup.exe",
      "HeyListen.AppImage"
    ],
    "args": [
      "--play",
      "{install}/HeyListen"
    ]
  },
  "prepare": {
    "program": [
      "HeyListenBuilder.exe",
      "HeyListen.AppImage"
    ],
    "args": [
      "--cli",
      "--prepare",
      "--game",
      "{game}",
      "--out",
      "{install}/HeyListen"
    ],
    "label": "Building the game from your copy (30 to 60 minutes)",
    "timeout": 14400,
    "version": "1",
    "done": [
      "{install}/HeyListen/image.bin"
    ],
    "options": [
      {
        "id": "dlss",
        "label": "Add NVIDIA DLSS",
        "note": "Downloads NVIDIA's DLSS SDK to this PC and builds the game with it. Never share a game folder built with it.",
        "args": [
          "--fetch-ngx-sdk",
          "--accept-nvidia-license"
        ],
        "gpu": "nvidia",
        "license": {
          "name": "NVIDIA RTX SDKs license",
          "url": "https://github.com/NVIDIA/DLSS/blob/9981c6350dc58c0ce21f024fd65e31e851c31689/LICENSE.txt"
        }
      },
      {
        "id": "fsr4",
        "label": "Add AMD FSR 4",
        "note": "Downloads AMD's signed FSR 4 runtime to this PC and builds the game with it (AMD cards with FSR 4).",
        "args": [
          "--fsr",
          "--fetch-fsr-runtime",
          "--accept-amd-license"
        ],
        "gpu": "amd",
        "os": [
          "windows"
        ],
        "license": {
          "name": "AMD FidelityFX SDK license",
          "url": "https://github.com/GPUOpen-LibrariesAndSDKs/FidelityFX-SDK/blob/7539ae8b6568ad29ed78a753404351daf3b5cca7/Kits/FidelityFX/docs/license.md"
        }
      },
      {
        "id": "send_perf_stats",
        "label": "Send anonymous performance statistics",
        "note": "Sends frame rates and the PC's graphics card and settings (no name, no files) after a play session. You can change it later in the game's menu or in Settings, Privacy.",
        "args": [
          "--send-perf-stats"
        ],
        "default": false
      },
      {
        "id": "send_crash_reports",
        "label": "Send crash reports automatically",
        "note": "If the game crashes, its report (what failed, the PC's parts, the log) is sent without asking. Off, the crash window asks each time. Change it later in Settings, Privacy.",
        "args": [
          "--send-crash-reports"
        ],
        "default": false
      }
    ]
  },
  "config": [
    {
      "id": "main",
      "format": "ini",
      "file": [
        {
          "path": "{install}/HeyListen/hookshot_options.ini"
        }
      ]
    }
  ],
  "groups": [
    {
      "id": "Video"
    },
    {
      "id": "Upscaling"
    },
    {
      "id": "Gameplay"
    },
    {
      "id": "Privacy"
    }
  ],
  "settings": [
    {
      "id": "preset",
      "label": "Quality preset",
      "help": "Sets the scaling rows and the video memory limits for a card with that much memory. Choose Custom to keep your own.",
      "group": "Video",
      "choices": [
        {
          "label": "Custom",
          "set": {
            "quality_preset": "0"
          }
        },
        {
          "label": "Minimum (4 GB)",
          "set": {
            "quality_preset": "1"
          }
        },
        {
          "label": "Low (6 GB)",
          "set": {
            "quality_preset": "2"
          }
        },
        {
          "label": "Balanced (8 GB)",
          "set": {
            "quality_preset": "3"
          }
        },
        {
          "label": "High (12 GB)",
          "set": {
            "quality_preset": "4"
          }
        },
        {
          "label": "Ultra (16 GB or more)",
          "set": {
            "quality_preset": "5"
          }
        }
      ],
      "defaults": {
        "quality_preset": "0"
      }
    },
    {
      "id": "fullscreen",
      "label": "Fullscreen",
      "help": "Fills the screen with the game, without the window's border. F11 does the same in the game.",
      "group": "Video",
      "choices": [
        {
          "label": "Off",
          "set": {
            "fullscreen": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "fullscreen": "1"
          }
        }
      ],
      "defaults": {
        "fullscreen": "0"
      }
    },
    {
      "id": "output_res",
      "label": "Output resolution",
      "help": "The size of the game's whole picture, HUD included. Applies at the next start.",
      "group": "Video",
      "choices": [
        {
          "label": "1920x1080",
          "set": {
            "output_res": "3"
          }
        },
        {
          "label": "2048x1152 (the game's own)",
          "set": {
            "output_res": "0"
          }
        },
        {
          "label": "2560x1440",
          "set": {
            "output_res": "1"
          }
        },
        {
          "label": "3840x2160",
          "set": {
            "output_res": "2"
          }
        },
        {
          "label": "5120x1440 (super ultrawide)",
          "set": {
            "output_res": "4"
          }
        }
      ],
      "defaults": {
        "output_res": "0"
      }
    },
    {
      "id": "ultrawide",
      "label": "Ultrawide",
      "help": "Draws the camera in the shape of a screen wider or narrower than 16:9. Applies at the next start.",
      "group": "Video",
      "choices": [
        {
          "label": "16:9",
          "set": {
            "ultrawide": "0"
          }
        },
        {
          "label": "The screen's shape",
          "set": {
            "ultrawide": "1"
          }
        }
      ],
      "defaults": {
        "ultrawide": "0"
      }
    },
    {
      "id": "fps_limit",
      "label": "Frame rate",
      "help": "The game's own frame rate. Above 60 it needs Game speed on Real time, and a screen that runs that fast.",
      "group": "Video",
      "choices": [
        {
          "label": "60 (the console's)",
          "set": {
            "frame_rate_limit": "0"
          }
        },
        {
          "label": "90",
          "set": {
            "frame_rate_limit": "1"
          }
        },
        {
          "label": "120",
          "set": {
            "frame_rate_limit": "2"
          }
        },
        {
          "label": "144",
          "set": {
            "frame_rate_limit": "3"
          }
        },
        {
          "label": "165",
          "set": {
            "frame_rate_limit": "4"
          }
        },
        {
          "label": "240",
          "set": {
            "frame_rate_limit": "5"
          }
        }
      ],
      "defaults": {
        "frame_rate_limit": "0"
      }
    },
    {
      "id": "game_speed",
      "label": "Game speed",
      "help": "How the game keeps time below 60 frames a second. Real time keeps its pace; Per frame slows it with the frames.",
      "group": "Video",
      "choices": [
        {
          "label": "Per frame",
          "set": {
            "game_speed": "0"
          }
        },
        {
          "label": "Real time",
          "set": {
            "game_speed": "1"
          }
        }
      ],
      "defaults": {
        "game_speed": "1"
      }
    },
    {
      "id": "framegen",
      "label": "Frame generation",
      "help": "Makes frames between the game's own for smoother motion, at a little input delay. Fast motion can show artifacts.",
      "group": "Video",
      "choices": [
        {
          "label": "Off",
          "set": {
            "frame_generation": "0"
          }
        },
        {
          "label": "Auto (to the screen's refresh)",
          "set": {
            "frame_generation": "1"
          }
        },
        {
          "label": "2x",
          "set": {
            "frame_generation": "2"
          }
        },
        {
          "label": "3x",
          "set": {
            "frame_generation": "3"
          }
        },
        {
          "label": "4x",
          "set": {
            "frame_generation": "4"
          }
        },
        {
          "label": "5x",
          "set": {
            "frame_generation": "5"
          }
        },
        {
          "label": "6x",
          "set": {
            "frame_generation": "6"
          }
        },
        {
          "label": "7x",
          "set": {
            "frame_generation": "7"
          }
        },
        {
          "label": "8x",
          "set": {
            "frame_generation": "8"
          }
        }
      ],
      "defaults": {
        "frame_generation": "0"
      }
    },
    {
      "id": "hdr",
      "label": "HDR",
      "help": "HDR10 output on an HDR screen (Windows: turn on Use HDR in the display settings).",
      "group": "Video",
      "choices": [
        {
          "label": "Off",
          "set": {
            "hdr": "0"
          }
        },
        {
          "label": "Expanded",
          "set": {
            "hdr": "1"
          }
        },
        {
          "label": "The game's own",
          "set": {
            "hdr": "2"
          }
        }
      ],
      "defaults": {
        "hdr": "0"
      }
    },
    {
      "id": "upscaler",
      "label": "Upscaler",
      "help": "What scales the 3D picture up to the output. DLSS needs an NVIDIA RTX card and its tick at setup; FSR 4 needs an AMD card with FSR 4 and its tick at setup; FSR 3.1 works on any card. Off runs no upscaling network at all (the 3D stretched to the output, no anti-aliasing), for a GPU where the game's own network shows glitches.",
      "group": "Upscaling",
      "choices": [
        {
          "label": "The game's own",
          "set": {
            "dlss": "0"
          }
        },
        {
          "label": "NVIDIA DLSS",
          "set": {
            "dlss": "1"
          }
        },
        {
          "label": "NVIDIA DLAA",
          "set": {
            "dlss": "2"
          }
        },
        {
          "label": "AMD FSR 3.1",
          "set": {
            "dlss": "3"
          }
        },
        {
          "label": "AMD FSR 4",
          "set": {
            "dlss": "4"
          }
        },
        {
          "label": "AMD FSR 4 Native AA",
          "set": {
            "dlss": "5"
          }
        },
        {
          "label": "Off",
          "set": {
            "dlss": "6"
          }
        }
      ],
      "defaults": {
        "dlss": "0"
      }
    },
    {
      "id": "render_res",
      "label": "Render resolution",
      "help": "The share of the output the 3D is drawn at; the upscaler fills in the rest. Auto follows the game's own dynamic resolution.",
      "group": "Upscaling",
      "choices": [
        {
          "label": "Auto",
          "set": {
            "resolution": "0"
          }
        },
        {
          "label": "100%",
          "set": {
            "resolution": "1"
          }
        },
        {
          "label": "75%",
          "set": {
            "resolution": "2"
          }
        },
        {
          "label": "Quality (67%)",
          "set": {
            "resolution": "3"
          }
        },
        {
          "label": "Balanced (58%)",
          "set": {
            "resolution": "5"
          }
        },
        {
          "label": "Performance (50%)",
          "set": {
            "resolution": "4"
          }
        },
        {
          "label": "Ultra Performance (33%)",
          "set": {
            "resolution": "6"
          }
        }
      ],
      "defaults": {
        "resolution": "0"
      }
    },
    {
      "id": "dlss_model",
      "label": "DLSS model",
      "help": "Which of NVIDIA's DLSS networks draws the picture. Used with DLSS and DLAA.",
      "group": "Upscaling",
      "choices": [
        {
          "label": "Transformer (K)",
          "set": {
            "dlss_model": "0"
          }
        },
        {
          "label": "Transformer 2 (M)",
          "set": {
            "dlss_model": "1"
          }
        },
        {
          "label": "Transformer 2 (L)",
          "set": {
            "dlss_model": "2"
          }
        },
        {
          "label": "NVIDIA's default",
          "set": {
            "dlss_model": "3"
          }
        }
      ],
      "defaults": {
        "dlss_model": "0"
      }
    },
    {
      "id": "filter",
      "label": "Window scaling filter",
      "help": "How the finished picture is scaled to the window when its size differs from the output resolution.",
      "group": "Upscaling",
      "choices": [
        {
          "label": "Off",
          "set": {
            "upscaling": "0"
          }
        },
        {
          "label": "Catmull-Rom",
          "set": {
            "upscaling": "1"
          }
        },
        {
          "label": "Lanczos",
          "set": {
            "upscaling": "2"
          }
        }
      ],
      "defaults": {
        "upscaling": "0"
      }
    },
    {
      "id": "sharpness",
      "label": "Sharpness",
      "help": "Sharpens the picture as it goes to the window. DLSS and DLAA look softer than the game's own: around 80% suits them.",
      "group": "Upscaling",
      "choices": [
        {
          "label": "0%",
          "set": {
            "sharpness": "0"
          }
        },
        {
          "label": "10%",
          "set": {
            "sharpness": "10"
          }
        },
        {
          "label": "20%",
          "set": {
            "sharpness": "20"
          }
        },
        {
          "label": "30%",
          "set": {
            "sharpness": "30"
          }
        },
        {
          "label": "40%",
          "set": {
            "sharpness": "40"
          }
        },
        {
          "label": "50%",
          "set": {
            "sharpness": "50"
          }
        },
        {
          "label": "60%",
          "set": {
            "sharpness": "60"
          }
        },
        {
          "label": "70%",
          "set": {
            "sharpness": "70"
          }
        },
        {
          "label": "80%",
          "set": {
            "sharpness": "80"
          }
        },
        {
          "label": "90%",
          "set": {
            "sharpness": "90"
          }
        },
        {
          "label": "100%",
          "set": {
            "sharpness": "100"
          }
        }
      ],
      "defaults": {
        "sharpness": "0"
      }
    },
    {
      "id": "reflex",
      "label": "NVIDIA Reflex",
      "help": "NVIDIA cards: each frame starts as late as it can, for less input delay. Not used with frame generation.",
      "group": "Upscaling",
      "choices": [
        {
          "label": "Off",
          "set": {
            "nvidia_reflex": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "nvidia_reflex": "1"
          }
        },
        {
          "label": "On + Boost",
          "set": {
            "nvidia_reflex": "2"
          }
        }
      ],
      "defaults": {
        "nvidia_reflex": "0"
      }
    },
    {
      "id": "text_speed",
      "label": "Text speed",
      "help": "How fast the letters of dialogue and other messages appear.",
      "group": "Gameplay",
      "choices": [
        {
          "label": "Normal",
          "set": {
            "text_speed": "0"
          }
        },
        {
          "label": "2x",
          "set": {
            "text_speed": "1"
          }
        },
        {
          "label": "4x",
          "set": {
            "text_speed": "2"
          }
        },
        {
          "label": "Instant",
          "set": {
            "text_speed": "3"
          }
        }
      ],
      "defaults": {
        "text_speed": "0"
      }
    },
    {
      "id": "skip_title",
      "label": "Skip title screen",
      "help": "Starts with your most recent saved game, pressing through the title screen. Does nothing until the game has a save.",
      "group": "Gameplay",
      "choices": [
        {
          "label": "Off",
          "set": {
            "skip_title_screen": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "skip_title_screen": "1"
          }
        }
      ],
      "defaults": {
        "skip_title_screen": "0"
      }
    },
    {
      "id": "fps_counter",
      "label": "FPS counter",
      "help": "Shows the frames a second in a corner. Full also shows the GPU, memory and CPU load. F10 cycles it in the game.",
      "group": "Gameplay",
      "choices": [
        {
          "label": "Off",
          "set": {
            "fps_counter": "0"
          }
        },
        {
          "label": "FPS",
          "set": {
            "fps_counter": "1"
          }
        },
        {
          "label": "Full",
          "set": {
            "fps_counter": "2"
          }
        }
      ],
      "defaults": {
        "fps_counter": "0"
      }
    },
    {
      "id": "audio_output",
      "label": "Audio output",
      "help": "The speakers the game mixes its sound for. Applies at the next start.",
      "group": "Gameplay",
      "choices": [
        {
          "label": "Auto",
          "set": {
            "audio_output": "0"
          }
        },
        {
          "label": "Stereo",
          "set": {
            "audio_output": "1"
          }
        },
        {
          "label": "5.1",
          "set": {
            "audio_output": "2"
          }
        }
      ],
      "defaults": {
        "audio_output": "0"
      }
    },
    {
      "id": "send_perf",
      "label": "Send performance statistics",
      "help": "Anonymous frame rates, the graphics card and the settings, sent after a play session. Needs a build that has a statistics address; off by default.",
      "group": "Privacy",
      "choices": [
        {
          "label": "Off",
          "set": {
            "send_performance_stats": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "send_performance_stats": "1"
          }
        }
      ],
      "defaults": {
        "send_performance_stats": "0"
      }
    },
    {
      "id": "send_crash",
      "label": "Send crash reports automatically",
      "help": "Sends a crash's report without asking. Off, the crash window asks first. Off by default.",
      "group": "Privacy",
      "choices": [
        {
          "label": "Off",
          "set": {
            "send_crash_reports": "0"
          }
        },
        {
          "label": "On",
          "set": {
            "send_crash_reports": "1"
          }
        }
      ],
      "defaults": {
        "send_crash_reports": "0"
      }
    }
  ],
  "saves": [
    "{install}/HeyListen/user/save",
    "{local}/heylisten/save",
    "{install}/HeyListen/hookshot_options.ini"
  ],
  "folders": {
    "saves": [
      {
        "path": "{install}/HeyListen/user/save",
        "if": "{install}/HeyListen/user/save"
      },
      {
        "path": "{local}/heylisten/save"
      }
    ],
    "game": [
      {
        "path": "{install}/HeyListen"
      }
    ],
    "logs": [
      {
        "path": "{install}/HeyListen/logs"
      }
    ],
    "mods": [
      {
        "path": "{install}/HeyListen/mods"
      }
    ]
  },
  "actions": [
    {
      "id": "saves",
      "label": "Saves",
      "help": "Where your saves are kept.",
      "open": "saves"
    },
    {
      "id": "game",
      "label": "Game folder",
      "help": "The built game, its settings file and its log.",
      "open": "game"
    },
    {
      "id": "logs",
      "label": "Log",
      "help": "The log of the last runs (hookshot.log is the newest; the same text is hookshot_log.txt in the game folder): send it with a bug report.",
      "open": "logs"
    },
    {
      "id": "mods",
      "label": "Mods",
      "help": "File mods go in this folder, one folder each.",
      "open": "mods"
    }
  ]
}
