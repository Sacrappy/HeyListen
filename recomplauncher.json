{
    "$schema": "https://recomplauncher.com/schema/recomplauncher.json",
    "format": 1,
    "name": "HeyListen",
    "repo": "Sacrappy/HeyListen",
    "game": {
        "kind": "iso_or_folder",
        "label": "Your own Switch 2 dump of The Legend of Zelda: Ocarina of Time as a .nup (program 0400486024DEC000, update v131072, build e0f3ccfa), or its extracted folder with exefs and romfs.",
        "check": {
            "nup_build_id": "e0f3ccfa"
        }
    },
    "prepare": {
        "program": [
            "HeyListenBuilder.exe",
            "HeyListen.AppImage"
        ],
        "args": [
            "--cli",
            "--prepare",
            "--game",
            "{game}",
            "--out",
            "{install}/HeyListen"
        ],
        "label": "Building the game from your copy",
        "timeout": 14400,
        "done": [
            "{install}/HeyListen/image.bin"
        ]
    },
    "start": {
        "program": [
            "HeyListen/bin/HeyListen.exe",
            "HeyListen/bin/hookshot"
        ],
        "env": {
            "HOOKSHOT_NO_UPDATE_CHECK": "1"
        }
    },
    "saves": [
        "{install}/HeyListen/user/save"
    ],
    "folders": {
        "saves": [
            {
                "path": "{install}/HeyListen/user/save"
            }
        ],
        "logs": [
            {
                "path": "{install}/HeyListen"
            }
        ]
    },
    "actions": [
        {
            "id": "saves",
            "label": "Saves",
            "help": "Your saves and the game's settings.",
            "open": "saves"
        }
    ]
}
