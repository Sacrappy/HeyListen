+    if (own_ranges_n.load(std::memory_order_acquire)) {
+        std::lock_guard lk(own_ranges_mu);
+        const int n = own_ranges_n.load(std::memory_order_relaxed);
+        bool hit = false;
+        for (int i = 0; i < n; i++) hit |= own_ranges[i].lo < p1 && own_ranges[i].hi > p0;
+        if (hit) {
