+# ---- (HeyListen, sprint 5: the refonte's job system) the BaseProc executors' twins: host/hos_thread.c hos_worker_* ----
+# OoT's executors are a worker set made by f_8069b020: a worker for each core of (config + 36) & 0x3e, and core 0 with the byte
+# at config + 16, in a loop over cores 0-5 (the set's array is sized by the mask's bits, f_8005e700). The six cores are in those
+# two constants: they ask the host, which answers as the game's text unless HOS_EXECUTORS widens the set named BaseProcExecutor
+# (the name at config + 24), and then cores 6 and up get a worker each. The game goes on using its six (a stage's cores are
+# `& 0x3f`, and its workers are found by their core): the others are twins. f_806b0260 registers a stage's workers with the
+# stage's scheduler; the host then adds each one's twin to the scheduler's list of contexts, which f_80b5ef60 made for six.
+# A worker's message handler f_8004aae0 runs the dispatcher (f_8004ab40) and signals the worker's end: it sends its twin the
+# same message first, and waits for the twin's end before its own signal.
+EX_DECL = ("int hos_worker_cores(uint64_t name);\nuint32_t hos_worker_list_room(void);\nvoid hos_worker_stage(uint64_t set);\n"
+           "uint64_t hos_worker_twin_kick(uint64_t worker);\nvoid hos_worker_twin_wait(Ctx *c, uint64_t twin);\n")
+EX_HEAD = "void f_8069b020(Ctx *__restrict A64_NOESC c) {\n"
+EX_MASK = "    { uint64_t _r = c->x[8] & 0x3eULL; _r &= 0xFFFFFFFFULL; c->x[8] = _r; }\n"
+EX_MASK_NEW = ("    { uint64_t _r = c->x[8] & (((1ULL << hos_worker_cores(recomp_load64(c,c->x[19] + 24))) - 1) & ~1ULL); "
+               "_r &= 0xFFFFFFFFULL; c->x[8] = _r; }   /* (nx2/oot_patches.py: the worker set's cores) */\n")
+EX_LOOP = "    { uint64_t _a=c->x[22], _b=6ULL; uint64_t _r=_a-_b; { uint64_t _fa=(_a),_fb=(_b),_fr=(_r); c->z=(_fr==0);    } }\n"
+EX_LOOP_NEW = EX_LOOP.replace("_b=6ULL", "_b=(uint64_t)hos_worker_cores(recomp_load64(c,c->x[19] + 24))")
+EX_RUN = "    { uint64_t _a=c->x[19], _b=216ULL; uint64_t _r=_a+_b; c->x[1]=_r; }\nc->x[30] = 0x8004ab10ULL; f_8004ab40(c);\n"
+# (function head, the text found once in it, its replacement)
+EX_EDITS = [
+    (EX_HEAD, EX_MASK, EX_MASK_NEW),
+    (EX_HEAD, EX_LOOP, EX_LOOP_NEW),
+    ("void f_80b5ef60(Ctx *__restrict A64_NOESC c) {\n",
+     "L_80b5f0c0:;\n    c->x[1] = 0x6ULL;\n",
+     "L_80b5f0c0:;\n    c->x[1] = (uint64_t)hos_worker_list_room();   /* (nx2/oot_patches.py: the list of contexts) */\n"),
+    ("void f_806b0260(Ctx *__restrict A64_NOESC c) {\n",
+     "L_806b03d0:;\nif (!((c->x[20] >> 0) & 1)) { goto L_806b0468; }\n",
+     "L_806b03d0:;\n    hos_worker_stage(c->x[19]);   /* (nx2/oot_patches.py: the workers' twins) */\n"
+     "if (!((c->x[20] >> 0) & 1)) { goto L_806b0468; }\n"),
+    ("void f_8004aae0(Ctx *__restrict A64_NOESC c) {\n",
+     EX_RUN,
+     "    { uint64_t _tw = hos_worker_twin_kick(c->x[19]);   /* (nx2/oot_patches.py: the worker's twin runs the stage too) */\n"
+     + EX_RUN + "    if (_tw) hos_worker_twin_wait(c, _tw); }\n"),
+]
+
+
+def patch_executors(source):
+    """None when none of the functions is here; else (text, how many of the edits are in it, made now or before)"""
+    done = 0
+    for head, old, new in EX_EDITS:
+        start, end = _body(source, head)
+        if start is None:
+            continue
+        body = source[start:end]
+        if new in body:
+            done += 1
+        elif body.count(old) == 1:
+            source = source[:start] + body.replace(old, new, 1) + source[end:]
+            done += 1
+    if not done:
+        return None
+    if EX_DECL not in source:
+        source = source.replace('#include "a64.h"\n', '#include "a64.h"\n' + EX_DECL, 1)
+    return source, done
+
