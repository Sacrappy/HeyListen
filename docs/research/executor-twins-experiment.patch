+/* (HeyListen, sprint 5: the refonte's job system) HOS_EXECUTORS=<n> (7 to 12, with HOS_CORES at least n; off: 6): OoT's
+   BaseProc executors get twins.
+   A stage's jobs are run by a dispatcher (f_8004ab40(scheduler, context)) on every context registered for the stage: the
+   set's worker threads (one a core, made by f_8069b020: its text has the six cores, `mask & 0x3e` and a loop to 6;
+   nx2/oot_patches.py patch_executors) and the stage's owner. All that says which workers take part goes by the six cores
+   (a stage's mask `& 0x3f`, a worker found by `1 << the caller's core`, the count of registered workers the end of the
+   frame waits to see at zero), so the workers past the sixth stay out of it: a twin is one more worker thread of the set,
+   on a core of its own (6 and up), that the game never registers.
+   hos_worker_stage (f_806b0260, once the game registered its workers) puts the twin of each registered worker in the
+   scheduler's list of contexts (the dispatcher wakes sleeping contexts from that list; f_80b5ef60 made it for six:
+   hos_worker_list_room) and resets it as the game resets its own. The worker's message handler f_8004aae0 sends the twin
+   its message before it runs the dispatcher (hos_worker_twin_kick) and waits for the twin's end before it signals its own
+   (hos_worker_twin_wait): to the game a worker and its twin are one worker, done when both are.
+   name: the set's name in guest memory (its config + 24); every other set (the module system's workers) keeps its six. */
+static int worker_n(void) {
+    static int n = -1;
+    if (n < 0) {
+        const char *e = getenv("HOS_EXECUTORS");
+        n = e && atoi(e) > 6 && atoi(e) <= 12 && atoi(e) <= hos_cores() ? atoi(e) : 6;
+        if (n > 6) hos_log("threads: %d BaseProc executors (HOS_EXECUTORS; HOS_CORES=%d)", n, hos_cores());
+    }
+    return n;
+}
+int hos_worker_cores(uint64_t name) {
+    const char *s = name ? (const char *)hos_guest_range(name, 17) : NULL;
+    return s && !memcmp(s, "BaseProcExecutor", 16) ? worker_n() : 6;
+}
+/* the room in a scheduler's list of contexts (f_80b5ef60's 6: five workers and the owner, or six workers) */
+uint32_t hos_worker_list_room(void) { return worker_n() > 6 ? 16 : 6; }
+/* core 1's twin is on core 6 ... core 5's on core 10, core 0's on core 11: the stages' owner is on core 0 more often than
+   not and runs the dispatcher itself there, its worker left out, so core 0's twin comes last */
+static int twin_core(int core) { return core ? core + 5 : 11; }
+static struct { uint64_t prim, twin; volatile LONG armed; } twin_tab[6];
+void hos_light_event_clear(uint64_t ev);
+void hos_light_event_wait(Ctx *c, uint64_t ev);
+int hos_light_queue_try_send(uint64_t q, uint64_t v);
+void hos_worker_stage(uint64_t set) {
+    if (worker_n() <= 6 || !hos_guest_range(set, 272)) return;
+    const uint32_t workers = G32(set);
+    if (workers <= 6 || workers > 12) return;   /* (another set: the module system's workers) */
+    const uint64_t arr = G64(set + 8), sched = G64(set + 264);
+    if (!sched || !hos_guest_range(sched, 64) || !hos_guest_range(arr, 8 * (uint64_t)workers)) return;
+    const uint32_t active = G32(set + 256);
+    uint64_t by_core[12] = { 0 };
+    uint32_t cores = 0;   /* (the cores of the workers the game registered) */
+    for (uint32_t i = 0; i < workers; i++) {
+        const uint64_t w = G64(G64(arr + 8 * (uint64_t)i) + 8);
+        const uint32_t m = G32(w + 176);
+        if (!m || (m & (m - 1)) || m >= 1u << 12) continue;
+        by_core[__builtin_ctz(m)] = w;
+        if (active >> i & 1) cores |= m;
+    }
+    int armed = 0, short_of_room = 0;
+    for (int core = 0; core < 6; core++) {
+        InterlockedExchange(&twin_tab[core].armed, 0);
+        const uint64_t tw = by_core[twin_core(core)];
+        if (!(cores >> core & 1) || !tw) continue;
+        const int32_t have = (int32_t)G32(sched + 48), room = (int32_t)G32(sched + 52);
+        if (have < 0 || have >= room) { short_of_room = 1; continue; }
+        G64(G64(sched + 56) + 8 * (uint64_t)have) = tw + 216;   /* (its context: the dispatcher's wakes) */
+        G32(sched + 48) = (uint32_t)(have + 1);
+        G64(tw + 224) = 0;   /* (as f_806b0260 resets a worker: the context's state and flags, its two events, its scheduler) */
+        G32(tw + 232) = 0;
+        G32(tw + 432) = 0;   /* (no lane in the cores' status word: those are eight, and the game's own) */
+        hos_light_event_clear(tw + 392);
+        hos_light_event_clear(tw + 488);
+        G64(tw + 512) = sched;
+        twin_tab[core].prim = by_core[core];
+        twin_tab[core].twin = tw;
+        InterlockedExchange(&twin_tab[core].armed, 1);
+        armed++;
+    }
+    static volatile LONG logged, full;
+    if (InterlockedIncrement(&logged) <= 12 || (short_of_room && InterlockedIncrement(&full) <= 12))
+        hos_log("threads: stage: set %#llx, %u workers, cores %#x, registered %#x (%u), %d twins, scheduler %#llx holds %d of %d%s",
+                (unsigned long long)set, workers, G32(set + 248), active, G32(set + 252), armed, (unsigned long long)sched,
+                (int)G32(sched + 48), (int)G32(sched + 52), short_of_room ? " (NO ROOM for a twin)" : "");
+}
+/* the worker's twin for this stage, sent its message now; 0: none (not a worker with a twin, or its twin is not in this
+   stage, or was sent already) */
+uint64_t hos_worker_twin_kick(uint64_t worker) {
+    if (worker_n() <= 6) return 0;
+    for (int core = 0; core < 6; core++)
+        if (twin_tab[core].prim == worker && twin_tab[core].armed && InterlockedExchange(&twin_tab[core].armed, 0)) {
+            const uint64_t tw = twin_tab[core].twin;
+            __atomic_fetch_or((uint32_t *)GP(tw + 232), 1u, __ATOMIC_SEQ_CST);   /* (the game's mark of a worker sent its message) */
+            static volatile LONG kicks;
+            const int sent = hos_light_queue_try_send(tw + 40, 1);
+            if (InterlockedIncrement(&kicks) <= 6)
+                hos_log("threads: twin: %s %s its twin on core %d", hos_thread_name(hos_self()), sent ? "sent" : "could NOT send", twin_core(core));
+            return sent ? tw : 0;
+        }
+    return 0;
+}
+void hos_worker_twin_wait(Ctx *c, uint64_t twin) { hos_light_event_wait(c, twin + 488); }
